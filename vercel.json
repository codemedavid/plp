{
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/products/(.*)",
      "destination": "/api/render"
    },
    {
      "source": "/research/(.*)",
      "destination": "/api/render"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}